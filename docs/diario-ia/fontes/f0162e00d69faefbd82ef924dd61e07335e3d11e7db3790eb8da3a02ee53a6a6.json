  "content": "<!doctype html>\n<html lang=\"pt-BR\"><meta charset=\"utf-8\"><base href=\"../\">\n<title>Revisão sequencial — quarto escuro</title>\n<style>body{margin:0;background:#14101e;color:#eee;font:14px sans-serif}canvas{display:block}p{margin:8px}</style>\n<canvas id=\"game\" width=\"960\" height=\"540\"></canvas><p id=\"feedback\"></p>\n<script type=\"module\">\n// Fixture determinística: preserva os mesmos sorteios entre intervenções e checkpoints.\nwindow.qaRandomState = Number(new URLSearchParams(location.search).get('seed') || 0x002BCAFE);\nMath.random = () => { window.qaRandomState = (Math.imul(1664525, window.qaRandomState) + 1013904223) >>> 0; return window.qaRandomState / 4294967296; };\n// A página de teste usa redimensionamento explícito, evitando callbacks tardios entre frames.\nwindow.ResizeObserver = undefined;\n// Instrumentação exclusiva de testes: o jogo distribuído não possui controles de teletransporte ou de relógio.\n// Importa o jogo real e expõe suas funções de atualização e renderização somente nesta página.\nimport {platforms,phase3Platforms,createBabyState,FLOOR_Y} from '../src/js/config.js';\nimport {PlatformRenderer,PLATFORM_SURFACES} from '../src/js/environment/PlatformRenderer.js';\nimport {BabyRenderer} from '../src/js/entities/BabyRenderer.js';\nlet source=await (await fetch('/src/js/game.js')).text();\nsource=source.replace(/from '(\\.\\/.+?)'/g,(_,p)=>`from '${new URL(p,location.origin+'/src/js/game.js')}'`);\nconst marker='  return {\\n    state,\\n    audio,';\nif(!source.includes(marker))throw Error('Marcador de instrumentação da revisão do jogo não encontrado');\n// As intervenções alteram somente o desenho; o estado original é restaurado antes da próxima atualização.\nconst cameraVariant = new URLSearchParams(location.search).get('variant') || 'todos';\nif (!['todos','sem-zoom','sem-damping','sem-offsets','sem-zoom-offsets','antes'].includes(cameraVariant)) throw Error('Variante de câmera inválida');\n// Reprodução anterior: retira somente as duas correções visuais, mantendo a simulação atual idêntica.\nif(cameraVariant==='antes') {\n  const stableMarker='stable: state.isPhase3 || plotTwistActive: state.plotTwistActive, anticipate: isPhase3: state.isPhase3,';\n  const verticalMarker='onGround: baby.onGround, active: state.isPhase3 || plotTwistActive: state.plotTwistActive,';\n  if(!source.includes(stableMarker)||!source.includes(verticalMarker))throw Error('Marcadores da comparação anterior não encontrados');\n  source=source.replaceAll(stableMarker,'stable: false, anticipate: false,');\n  source=source.replace(verticalMarker,'onGround: baby.onGround, active: false,');\n  source=source.replaceAll('cameraVisibility: isPhase3: state.isPhase3,','cameraVisibility: false,');\n}\nlet shadowCamera;\nif (cameraVariant === 'sem-damping') {\n  let controller = await (await fetch('/src/js/controllers/CameraController.js')).text();\n  controller = controller.replace(/\\* 0\\.(?:05|06|07|08|09|12)(?: \\* dt)?/g, '* 1');\n  const { CameraController } = await import(URL.createObjectURL(new Blob([controller], {type:'text/javascript'})));\n  shadowCamera = new CameraController({floorY:FLOOR_Y});\n}\nwindow.cameraAblation = { variant: cameraVariant, shadowCamera };\nsource = source.replace('  function render() {', `  function renderOriginalQa() {`);\nsource = source.replace('    ctx.translate(mobileFrame.x, mobileFrame.y);',\n  `    if(['sem-zoom','sem-zoom-offsets'].includes(window.cameraAblation.variant))mobileFrame.zoom=1;\n    if(['sem-offsets','sem-zoom-offsets'].includes(window.cameraAblation.variant)){mobileFrame.x=0;mobileFrame.y=0;}\n    ctx.translate(mobileFrame.x, mobileFrame.y);`);\nconst renderMarker = '  function renderOriginalQa() {';\nsource = source.replace(renderMarker, `\n  function render() {\n    const mode=window.cameraAblation.variant;\n    const saved={x:state.cameraX,y:state.cameraY,zoom:state.cameraZoom,cx:camera.x,cy:camera.y,cz:camera.zoom};\n    const originalOffset=androidFraming.offset;\n    const originalTransform=camera.applyTransform;\n    const actorsBefore=JSON.stringify({baby,fairy});\n    const randomBefore=window.qaRandomState;\n    window.cameraAblation.originalCamera=saved;\n    try {\n      if(['sem-zoom','sem-zoom-offsets'].includes(mode)){\n        // Preserva os offsets calculados; remove exclusivamente as duas escalas de zoom.\n        camera.applyTransform=function(ctx){ctx.translate(0,-this.y);};\n      }\n      if(['sem-offsets','sem-zoom-offsets'].includes(mode)) {\n        androidFraming.offset=()=>0;\n        // O pivô passa a ser o centro fixo do viewport, sem offset contextual da fada.\n        camera.applyTransform=function(ctx,canvas){\n          ctx.translate(canvas.width/2,canvas.height/2);const zoom=mode==='sem-zoom-offsets'?1:this.zoom;ctx.scale(zoom,zoom);\n          ctx.translate(-canvas.width/2,-canvas.height/2);ctx.translate(0,-this.y);\n        };\n      }\n      if(mode==='sem-damping') {\n        const shadow=window.cameraAblation.shadowCamera;\n        const observed={...state,baby:{...baby},fairy:{...fairy},cameraX: state.cameraX,cameraY: state.cameraY,cameraZoom: state.cameraZoom,targetCameraY: state.targetCameraY,targetCameraZoom: state.targetCameraZoom};\n        shadow.syncFromState(observed);\n        shadow.update(1,observed,canvas,{escapeEndPlatformIndex:platforms.length-1,exitDoorX:trueExitDoor.x,exitDoorW:trueExitDoor.w});\n        const narrative=opening.active||state.isStandbyActive||state.isStandbyTransitioning||state.cutsceneActive||state.plotTwistActive||state.phase3TutorialActive||state.truePortalTransitionActive;\n        state.cameraX=shadow.x;state.cameraY=narrative?saved.y:shadow.y;state.cameraZoom=state.targetCameraZoom;\n        camera.x=state.cameraX;camera.y=state.cameraY;camera.zoom=state.cameraZoom;\n      }\n      renderOriginalQa();\n    } finally {\n      window.qaRandomState=randomBefore;\n      state.cameraX=saved.x;state.cameraY=saved.y;state.cameraZoom=saved.zoom;\n      camera.x=saved.cx;camera.y=saved.cy;camera.zoom=saved.cz;\n      androidFraming.offset=originalOffset;camera.applyTransform=originalTransform;\n      if(JSON.stringify({baby,fairy})!==actorsBefore)throw Error('A intervenção visual alterou os atores');\n    }\n  }\n` + renderMarker);\nsource = source.replace('      cameraX: state.cameraX, cameraY: state.cameraY, cameraZoom: state.cameraZoom, playerX: baby.x, playerY: baby.y,',\n  `      cameraX: state.cameraX, cameraY: state.cameraY, cameraZoom: state.cameraZoom, originalCamera: window.cameraAblation.originalCamera,\n      variant: window.cameraAblation.variant, playerVx: baby.vx, playerVy: baby.vy,targetCameraY: state.targetCameraY,targetCameraZoom: state.targetCameraZoom,\n      playerX: baby.x, playerY: baby.y,`);\nsource=source.replace(marker,`  return {\n    review: {\n      roomManual(){return state.toyRoomInstance?.instance;},\n      beginManual(){newCampaign();state.loopStarted=true;state.gameStarted=true;opening.reset();opening.start();syncLocalsToState();},\n      saveManual(){syncLocalsToState();return {state:captureState(state),opening:opening.snapshot(),cameraPresentation:cameraPresentation.snapshot(),random:window.qaRandomState};},\n      restoreManual(saved){cameraPresentation.restore(saved.cameraPresentation);window.qaRandomState=saved.random;clearTimeout(failMessageTimer);restoreState(state,saved.state);opening.restore(saved.opening);syncStateToLocals();camera.syncFromState(state);},\n      inspectManual(){syncLocalsToState();return {baby:{...baby},opening:opening.active,standby:isStandbyActive: state.isStandbyActive,\n        transition:isStandbyTransitioning: state.isStandbyTransitioning,cutscene:cutsceneActive: state.cutsceneActive,cutsceneStep: state.cutsceneStep,plot:plotTwistActive: state.plotTwistActive,plotStep:plotTwistStep: state.plotTwistStep,\n        phase3:isPhase3: state.isPhase3,tutorial:phase3TutorialActive: state.phase3TutorialActive,portal:truePortalTransitionActive: state.truePortalTransitionActive,mode:currentPhaseMode: state.currentPhaseMode,over:isGameOver: state.isGameOver};},\n      actionManual(){state.standbyActivatedTime=-10000;state.lastDialogueAdvanceTime=-10000;state.lastJumpTime=-10000;doJump();syncLocalsToState();},\n      frameManual(draw=false){\n        if(state.currentPhaseMode==='toy-room'){state.toyRoomInstance.update(1);if(draw)state.toyRoomInstance.render();}\n        else {update(1);syncLocalsToState();if(draw)render();}\n      },\n      mobileFrame(after = true, index = -1, phase3 = false) {\n        cameraPresentation.reset();\n        state.cameraX=0;state.cameraY=Math.min(0,FLOOR_Y-(canvas.height-110));state.cameraZoom=1;\n        const p=(phase3?phase3Platforms:platforms)[index];\n        state.isPhase3=phase3;\n        baby.x=p?p.x:(phase3?4300:100);baby.y=(p?(p.surfaceTopY??p.standRegion?.y??p.y):FLOOR_Y)-baby.h;\n        baby.isCrouching=false;baby.currentPlatformIndex=index;\n        state.cameraX=phase3?baby.x-(canvas.width-160):Math.max(0,baby.x-120);\n        state.cameraY=Math.min(state.cameraY,baby.y-130);\n        fairy.x=baby.x+(phase3?-55:55);fairy.y=baby.y-46;\n        opening.cancel();syncLocalsToState();camera.syncFromState(state);\n        const original=androidFraming.offset;\n        let framing;\n        androidFraming.offset=(feetY,topY)=>{\n          const offset=after?original(feetY,topY):0;\n          framing={feetY,topY,offset,feetAfter:feetY-offset,topAfter:topY-offset};\n          return offset;\n        };\n        const before=JSON.stringify({baby,platforms,phase3Platforms,cameraY: state.cameraY});\n        const apply=camera.applyTransform;\n        let transform;\n        camera.applyTransform=function(...args){apply.apply(this,args);transform=ctx.getTransform();};\n        render();camera.applyTransform=apply;androidFraming.offset=original;\n        if(before!==JSON.stringify({baby,platforms,phase3Platforms,cameraY: state.cameraY})) throw Error('Renderização alterou a simulação');\n        return {width:canvas.width,height:canvas.height,cameraY: state.cameraY,babyY:baby.y,playerFeetAfter:baby.y+baby.h-state.cameraY-framing.offset,...framing,\n          zoom:transform.a, player:{x:baby.x,y:baby.y,w:baby.w,h:baby.h},fairy:{x:fairy.x,y:fairy.y},\n          next:(phase3?phase3Platforms:platforms)[index+1],cameraX: state.cameraX,\n          transform:{a:transform.a,d:transform.d,e:transform.e,f:transform.f}};\n      },\n      setMobileZoom(enabled){mobilePresentation.enabled=enabled;},\n      openingFrame(time) { opening.time=time; opening.active=true; render(); opening.cancel(); },\n      prepare(index, x, phase3 = false) {\n        cameraPresentation.reset();\n        const p=(phase3 ? phase3Platforms : platforms)[index];\n        const y=p ? (p.surfaceTopY ?? p.standRegion?.y ?? p.y) : FLOOR_Y;\n        Object.assign(baby,createBabyState(),{x,y:y-44,currentPlatformIndex:index,\n          controlsLocked:false,isCrouching:false,respawnLandingPending:false,\n          isEscaping:!phase3&&index>=9,longJumpUnlocked:!phase3&&index>=9});\n        Object.assign(state,{gameStarted:true,gameWon:false,isGameOver:false,\n          isStandbyActive:false,isStandbyTransitioning:false,cutsceneActive:false,\n          cutsceneTriggered:true,cutsceneCompleted:index>=9,isEscapeMode:!phase3&&index>=9,\n          escapeLevel:Math.max(0,index-9),isPhase3:phase3,phase3Level:Math.max(0,index),phase3TutorialActive:false,plotTwistActive:false,plotTwistTriggered:true,\n          firstPlatformCleared:index>=0,truePortalTransitionActive:false,\n          cameraX:x-250,cameraY:0,targetCameraY:0,cameraZoom:1,targetCameraZoom:1,\n          lastJumpTime:-10000});\n        particles.clear();fairy.particles.length=0;\n        fairy.x=x+35;fairy.y=y-75;\n        state.escapeBannerTimer=0;\n        syncStateToLocals();camera.syncFromState(state);\n      },\n      step(dt=1){update(dt);syncLocalsToState();},\n      jump(){state.lastJumpTime=-10000;doJump();syncLocalsToState();},\n      draw(){state.cameraX=baby.x-350;state.cameraY=0;state.cameraZoom=1;\n        syncLocalsToState();camera.syncFromState(state);render();}\n    },\n    state,\n    audio,`);\nconst {createGame}=await import(URL.createObjectURL(new Blob([source],{type:'text/javascript'})));\nconst game=createGame(document.querySelector('canvas'),document.querySelector('#feedback'));\nawait game.assetsReady;game.setMuted(true);\nconst support=p=>({x:p.standRegion?.x??p.x,w:p.standRegion?.w??p.w,y:p.surfaceTopY??p.standRegion?.y??p.y});\nwindow.review={game,platforms,results:[],\n  run(target,dt=1,phase3=false){\n    const active=phase3?phase3Platforms:platforms;\n    const from=target? support(active[target-1]):phase3?{x:4170,w:470,y:FLOOR_Y}:{x:60,w:160,y:FLOOR_Y};\n    const leftOverlap=phase3&&target>0?37:0;\n    const positions=Array.from({length:Math.floor(from.w)+leftOverlap},(_,i)=>from.x-leftOverlap+i);\n    positions.sort((a,b)=>Math.abs(a-(from.x+(from.w-38)/2))-Math.abs(b-(from.x+(from.w-38)/2)));\n    for(const x of positions){\n      game.review.prepare(target-1,x,phase3);game.review.jump();\n      if(game.state.baby.onGround)throw Error('O salto não começou');\n      for(let frame=0;frame<220;frame++){\n        game.review.step(dt);\n        const b=game.state.baby;\n        if(game.isGameOver())break;\n        if(b.onGround){\n          if(b.currentPlatformIndex===target){\n            const p=support(active[target]);\n            if(Math.abs(b.y+b.h-p.y)>0.001)throw Error('Os pés não estão sobre o apoio');\n            const result={target,phase:phase3?3:target<10?1:2,style:active[target].style,dt,launchX:x,frames:frame+1,feet:b.y+b.h,surface:p.y};\n            this.results.push(result);game.review.draw();return result;\n          }break;\n        }\n      }\n    }\n    throw Error('Nenhum salto bem-sucedido no jogo real até '+target+' '+active[target].style);\n  },\n  contacts(index,dt=1){\n    const s=support(platforms[index]);\n    const cases=[['esquerda',s.x],['centro',s.x+(s.w-38)/2],['direita',s.x+s.w-38]];\n    for(const [name,x] of cases){\n      game.review.prepare(index,x);\n      const b=game.state.baby;\n      Object.assign(b,{y:s.y-b.h-60,vy:0,vx:0,onGround:false});\n      let landed=false;\n      for(let frame=0;frame<120;frame++){\n        b.vx=0;game.review.step(dt);\n        if(b.onGround){\n          if(b.currentPlatformIndex!==index)throw Error(`${index}: ${name} pousou na plataforma errada`);\n          if(Math.abs(b.y+b.h-s.y)>0.001)throw Error(`${index}: ${name} desalinhamento dos pés`);\n          landed=true;break;\n        }\n      }\n      if(!landed)throw Error(`${index}: ${name} falha na queda`);\n      for(let frame=0;frame<8;frame++){\n        b.vx=0;game.review.step(dt);\n        if(!b.onGround||Math.abs(b.y+b.h-s.y)>0.001)throw Error(`${index}: apoio instável em ${name}`);\n      }\n    }\n    return {target:index,dt,drops:3,stableFrames:8};\n  },\n  visibleSupport(index){\n    const p=platforms[index],s=support(p),calibration=PLATFORM_SURFACES[p.style];\n    if(!calibration?.cap)return {checked:false};\n    const canvas=document.createElement('canvas');canvas.width=512;canvas.height=512;\n    const ctx=canvas.getContext('2d'),renderer=new PlatformRenderer({assets:game.assets});\n    const previous=window.DEBUG_COLLISIONS;window.DEBUG_COLLISIONS=false;\n    try {\n      ctx.save();ctx.translate(100-s.x,120-s.y);\n      renderer.renderPlatforms(ctx,{width:10000},0,{platforms:[p]});ctx.restore();\n      const pixels=ctx.getImageData(100,120,s.w,1).data;\n      for(let x=0;x<s.w;x++)if(pixels[x*4+3]!==255){\n        throw Error(`${index}: apoio visual transparente em x=${x}`);\n      }\n      // Verifica os fragmentos removidos do atlas em uma área de desenho transparente.\n      const scale=s.w/calibration.surfaceW;\n      const dw=Math.round(calibration.origW*scale),dh=Math.round(calibration.origH*scale);\n      const dx=Math.round(100-calibration.surfaceX*scale),dy=Math.round(120-calibration.surfaceY*scale);\n      for(const [x,y,w,h] of calibration.excludeRects||[]){\n        const px=Math.floor(dx+(x+w/2)*dw/calibration.origW);\n        const py=Math.floor(dy+(y+h/2)*dh/calibration.origH);\n        if(ctx.getImageData(px,py,1,1).data[3]!==0)throw Error(`${index}: fragmento do atlas ainda visível`);\n      }\n      return {checked:true,opaqueSupportPixels:s.w,excludedFragments:calibration.excludeRects?.length||0};\n    } finally {window.DEBUG_COLLISIONS=previous;}\n  },\n  detail(index){\n    const p=platforms[index],s=support(p),canvas=document.createElement('canvas');\n    canvas.width=960;canvas.height=400;\n    const ctx=canvas.getContext('2d'),renderer=new PlatformRenderer({assets:game.assets});\n    const character=new BabyRenderer(),previous=window.DEBUG_COLLISIONS;\n    window.DEBUG_COLLISIONS=false;\n    try {\n      for(const [i,[label,x]] of [['Esquerda',s.x],['Centro',s.x+(s.w-38)/2],['Direita',s.x+s.w-38]].entries()){\n        ctx.save();ctx.beginPath();ctx.rect(i*320,0,320,400);ctx.clip();\n        ctx.fillStyle='#211b2d';ctx.fillRect(i*320,0,320,400);\n        ctx.fillStyle='#fff';ctx.font='14px sans-serif';ctx.fillText(`${index}: ${p.style} — ${label}`,i*320+12,24);\n        ctx.translate(i*320+160-s.x-s.w/2,120-s.y);\n        renderer.renderPlatforms(ctx,{width:10000},0,{platforms:[p]});\n        const b={...createBabyState(),x,y:s.y-44,animTime:0,onGround:true};\n        character.render(ctx,b);\n        // Marca somente as extremidades, mantendo visível o contato real entre o sapato e o objeto.\n        ctx.strokeStyle='#4ade80';ctx.lineWidth=1;\n        for(const edge of [s.x,s.x+s.w]){\n          ctx.beginPath();ctx.moveTo(edge,s.y-6);ctx.lineTo(edge,s.y+8);ctx.stroke();\n        }\n        ctx.restore();\n      }\n      return canvas.toDataURL('image/png').split(',')[1];\n    } finally {window.DEBUG_COLLISIONS=previous;}\n  },\n  show(index,debug=false){const s=support(platforms[index]);game.review.prepare(index,s.x+(s.w-38)/2);\n    game.state.baby.vx=0;window.DEBUG_COLLISIONS=debug;game.review.draw();}\n};\ndocument.body.dataset.ready='true';\n// Ponto de entrada opcional para revisão sem interface gráfica: exercita o ciclo real de atualização e\n// mostra detalhes dos contatos sem adicionar controles de depuração ao jogo distribuído.\nif (new URLSearchParams(location.search).has('verify')) {\n  try {\n    for (const dt of [0.5, 1, 1.2]) {\n      for (let target=0; target<=21; target++) window.review.run(target,dt);\n      for (let target=0; target<=15; target++) window.review.run(target,dt,true);\n      game.review.prepare(9,1631);\n      for (let frame=0; frame<300; frame++) {\n        game.review.step(dt);\n        const b=game.state.baby;\n        if (!b.onGround || b.x!==1631 || b.y!==192 || b.vx!==0)\n          throw Error(`Falha na pausa do castelo em dt=${dt}, quadro=${frame}`);\n      }\n      game.review.jump();\n      for(let frame=0;frame<240 && !game.state.baby.onGround;frame++) game.review.step(dt);\n      if(game.state.baby.currentPlatformIndex!==10)throw Error('O salto do castelo não alcançou o trem');\n    }\n    const gallery=document.createElement('div');\n    for (const index of [10,11,12]) {\n      const img=new Image();img.src='data:image/png;base64,'+window.review.detail(index);\n      img.style.width='960px';img.style.display='block';gallery.append(img);\n    }\n    document.querySelector('canvas').remove();document.body.prepend(gallery);\n    document.querySelector('#feedback').textContent='APROVADO: atualizações reais, 114 saltos e 900 quadros de pausa no castelo';\n    document.body.dataset.result='passed';\n  } catch(error) {\n    document.body.dataset.result='failed';\n    document.querySelector('#feedback').textContent=error.stack;\n  }\n}\n</script></html>\n"
}
