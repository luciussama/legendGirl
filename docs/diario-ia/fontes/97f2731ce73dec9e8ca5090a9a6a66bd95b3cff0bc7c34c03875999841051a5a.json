  "encoding": "utf-8",
  "content": "<!doctype html>\n<html lang=\"pt-BR\"><meta charset=\"utf-8\"><base href=\"/\">\n<title>Revisão sequencial — quarto escuro</title>\n<style>body{margin:0;background:#14101e;color:#eee;font:14px sans-serif}canvas{display:block}p{margin:8px}</style>\n<canvas id=\"game\" width=\"960\" height=\"540\"></canvas><p id=\"feedback\"></p>\n<script type=\"module\">\n// Instrumentação exclusiva de testes: o jogo distribuído não possui controles de teletransporte ou de relógio.\n// Importa o jogo real e expõe suas funções de atualização e renderização somente nesta página.\nimport {platforms,phase3Platforms,createBabyState,FLOOR_Y} from '../src/js/config.js';\nimport {PlatformRenderer,PLATFORM_SURFACES} from '../src/js/environment/PlatformRenderer.js';\nimport {BabyRenderer} from '../src/js/entities/BabyRenderer.js';\nconst sourcePath=new URLSearchParams(location.search).get('source') || '/src/js/game.js';\nlet source=await (await fetch(sourcePath)).text();\nsource=source.replace(/from '(\\.\\/.+?)'/g,(_,p)=>`from '${new URL(p,location.origin+'/src/js/game.js')}'`);\nconst marker='  return {\\n    state,\\n    audio,';\nif(!source.includes(marker))throw Error('Marcador de instrumentação da revisão do jogo não encontrado');\nsource=source.replace(marker,`  return {\n    review: {\n      roomManual(){return state.toyRoomInstance?.instance;},\n      renderManual(){render();},\n      beginManual(){newCampaign();state.loopStarted=true;state.gameStarted=true;syncViewportFromState();opening.reset();opening.start();syncViewportToState();},\n      saveManual(){syncViewportToState();return {state:captureState(state),opening:opening.snapshot(),cameraPresentation:cameraPresentation.snapshot()};},\n      restoreManual(saved){cameraPresentation.restore(saved.cameraPresentation);clearTimeout(failMessageTimer);restoreState(state,saved.state);opening.restore(saved.opening);syncViewportFromState();camera.syncFromState(state);},\n      inspectManual(){syncViewportToState();return {baby:{...baby},opening:opening.active,standby:state.isStandbyActive,\n        transition:state.isStandbyTransitioning,cutscene:state.cutsceneActive,cutsceneStep: state.cutsceneStep,plot:state.plotTwistActive,plotStep:state.plotTwistStep,\n        phase3:state.isPhase3,tutorial:state.phase3TutorialActive,firstJump:state.gameplayState==='FIRST_JUMP_TUTORIAL',portal:state.truePortalTransitionActive,toyIntro:toyRoomIntroduction.active,mode:state.currentPhaseMode,over:state.isGameOver};},\n      actionManual(){state.standbyActivatedTime=-10000;state.lastDialogueAdvanceTime=-10000;state.lastJumpTime=-10000;syncViewportFromState();doJump('keyboard');syncViewportToState();},\n      frameManual(draw=false){\n        if(state.currentPhaseMode==='toy-room'){state.toyRoomInstance.update(1);if(draw)state.toyRoomInstance.render();}\n        else {update(1);syncViewportToState();if(draw)render();}\n      },\n      mobileFrame(after = true, index = -1, phase3 = false) {\n        cameraPresentation.reset();\n        state.cameraX=0;state.cameraY=Math.min(0,FLOOR_Y-(canvas.height-110));state.cameraZoom=1;\n        const p=(phase3?phase3Platforms:platforms)[index];\n        state.isPhase3=phase3;\n        baby.x=p?p.x:(phase3?4300:100);baby.y=(p?(p.surfaceTopY??p.standRegion?.y??p.y):FLOOR_Y)-baby.h;\n        baby.isCrouching=false;baby.currentPlatformIndex=index;\n        state.cameraX=phase3?baby.x-(canvas.width-160):Math.max(0,baby.x-120);\n        state.cameraY=Math.min(state.cameraY,baby.y-130);\n        fairy.x=baby.x+(phase3?-55:55);fairy.y=baby.y-46;\n        opening.cancel();syncViewportFromState();camera.syncFromState(state);\n        const original=androidFraming.offset;\n        let framing;\n        androidFraming.offset=(feetY,topY)=>{\n          const offset=after?original(feetY,topY):0;\n          framing={feetY,topY,offset,feetAfter:feetY-offset,topAfter:topY-offset};\n          return offset;\n        };\n        const before=JSON.stringify({baby,platforms,phase3Platforms,cameraY: state.cameraY});\n        const apply=camera.applyTransform;\n        let transform;\n        camera.applyTransform=function(...args){apply.apply(this,args);transform=ctx.getTransform();};\n        render();camera.applyTransform=apply;androidFraming.offset=original;\n        if(before!==JSON.stringify({baby,platforms,phase3Platforms,cameraY: state.cameraY})) throw Error('Renderização alterou a simulação');\n        return {width:canvas.width,height:canvas.height,cameraY: state.cameraY,babyY:baby.y,playerFeetAfter:baby.y+baby.h-state.cameraY-framing.offset,...framing,\n          zoom:transform.a, player:{x:baby.x,y:baby.y,w:baby.w,h:baby.h},fairy:{x:fairy.x,y:fairy.y},\n          next:(phase3?phase3Platforms:platforms)[index+1],cameraX: state.cameraX,\n          transform:{a:transform.a,d:transform.d,e:transform.e,f:transform.f}};\n      },\n      setMobileZoom(enabled){mobilePresentation.enabled=enabled;},\n      openingFrame(time) { opening.time=time; opening.active=true; render(); opening.cancel(); },\n      prepare(index, x, phase3 = false) {\n        cameraPresentation.reset();\n        const p=(phase3 ? phase3Platforms : platforms)[index];\n        const y=p ? (p.surfaceTopY ?? p.standRegion?.y ?? p.y) : FLOOR_Y;\n        Object.assign(baby,createBabyState(),{x,y:y-44,currentPlatformIndex:index,\n          controlsLocked:false,isCrouching:false,respawnLandingPending:false,\n          isEscaping:!phase3&&index>=9,longJumpUnlocked:!phase3&&index>=9});\n        Object.assign(state,{gameStarted:true,gameWon:false,isGameOver:false,\n          isStandbyActive:false,isStandbyTransitioning:false,cutsceneActive:false,\n          cutsceneTriggered:true,cutsceneCompleted:index>=9,isEscapeMode:!phase3&&index>=9,\n          escapeLevel:Math.max(0,index-9),isPhase3:phase3,phase3Level:Math.max(0,index),phase3TutorialActive:false,plotTwistActive:false,plotTwistTriggered:true,\n          firstPlatformCleared:index>=0,truePortalTransitionActive:false,\n          cameraX:x-250,cameraY:0,targetCameraY:0,cameraZoom:1,targetCameraZoom:1,\n          lastJumpTime:-10000});\n        particles.clear();fairy.particles.length=0;\n        fairy.x=x+35;fairy.y=y-75;\n        state.escapeBannerTimer=0;\n        syncViewportFromState();camera.syncFromState(state);\n      },\n      step(dt=1){update(dt);syncViewportToState();},\n      jump(){state.lastJumpTime=-10000;syncViewportFromState();doJump('keyboard');syncViewportToState();},\n      draw(){state.cameraX=baby.x-350;state.cameraY=0;state.cameraZoom=1;\n        syncViewportFromState();camera.syncFromState(state);render();}\n    },\n    state,\n    audio,`);\n// Observação do retorno do renderer extraído; não altera a implementação de produção.\nconst pipelineUrl=new URL('/src/js/rendering/DarkRoomRenderPipeline.js',location.origin).href;\nlet pipelineSource=await(await fetch(pipelineUrl)).text();\npipelineSource=pipelineSource.replace(/from '(\\.{1,2}\\/.+?)'/g,(_,p)=>`from '${new URL(p,pipelineUrl)}'`);\nconst rendererMarker='    renderFirstJumpTutorial(ctx, canvas,';\nif(!pipelineSource.includes(rendererMarker))throw Error('Marcador do renderer do tutorial não encontrado');\npipelineSource=pipelineSource.replace(rendererMarker,'    window.firstJumpTutorialLayout = renderFirstJumpTutorial(ctx, canvas,');\nsource=source.replace(pipelineUrl,URL.createObjectURL(new Blob([pipelineSource],{type:'text/javascript'})));\nconst {createGame}=await import(URL.createObjectURL(new Blob([source],{type:'text/javascript'})));\nconst game=createGame(document.querySelector('canvas'),document.querySelector('#feedback'));\nawait game.assetsReady;game.setMuted(true);\nconst support=p=>({x:p.standRegion?.x??p.x,w:p.standRegion?.w??p.w,y:p.surfaceTopY??p.standRegion?.y??p.y});\nwindow.review={game,platforms,results:[],\n  run(target,dt=1,phase3=false){\n    const active=phase3?phase3Platforms:platforms;\n    const from=target? support(active[target-1]):phase3?{x:4170,w:470,y:FLOOR_Y}:{x:60,w:160,y:FLOOR_Y};\n    const leftOverlap=phase3&&target>0?37:0;\n    const positions=Array.from({length:Math.floor(from.w)+leftOverlap},(_,i)=>from.x-leftOverlap+i);\n    positions.sort((a,b)=>Math.abs(a-(from.x+(from.w-38)/2))-Math.abs(b-(from.x+(from.w-38)/2)));\n    for(const x of positions){\n      game.review.prepare(target-1,x,phase3);game.review.jump();\n      if(game.state.baby.onGround)throw Error('O salto não começou');\n      for(let frame=0;frame<220;frame++){\n        game.review.step(dt);\n        const b=game.state.baby;\n        if(game.isGameOver())break;\n        if(b.onGround){\n          if(b.currentPlatformIndex===target){\n            const p=support(active[target]);\n            if(Math.abs(b.y+b.h-p.y)>0.001)throw Error('Os pés não estão sobre o apoio');\n            const result={target,phase:phase3?3:target<10?1:2,style:active[target].style,dt,launchX:x,frames:frame+1,feet:b.y+b.h,surface:p.y};\n            this.results.push(result);game.review.draw();return result;\n          }break;\n        }\n      }\n    }\n    throw Error('Nenhum salto bem-sucedido no jogo real até '+target+' '+active[target].style);\n  },\n  contacts(index,dt=1){\n    const s=support(platforms[index]);\n    const cases=[['esquerda',s.x],['centro',s.x+(s.w-38)/2],['direita',s.x+s.w-38]];\n    for(const [name,x] of cases){\n      game.review.prepare(index,x);\n      const b=game.state.baby;\n      Object.assign(b,{y:s.y-b.h-60,vy:0,vx:0,onGround:false});\n      let landed=false;\n      for(let frame=0;frame<120;frame++){\n        b.vx=0;game.review.step(dt);\n        if(b.onGround){\n          if(b.currentPlatformIndex!==index)throw Error(`${index}: ${name} pousou na plataforma errada`);\n          if(Math.abs(b.y+b.h-s.y)>0.001)throw Error(`${index}: ${name} desalinhamento dos pés`);\n          landed=true;break;\n        }\n      }\n      if(!landed)throw Error(`${index}: ${name} falha na queda`);\n      for(let frame=0;frame<8;frame++){\n        b.vx=0;game.review.step(dt);\n        if(!b.onGround||Math.abs(b.y+b.h-s.y)>0.001)throw Error(`${index}: apoio instável em ${name}`);\n      }\n    }\n    return {target:index,dt,drops:3,stableFrames:8};\n  },\n  visibleSupport(index){\n    const p=platforms[index],s=support(p),calibration=PLATFORM_SURFACES[p.style];\n    if(!calibration?.cap)return {checked:false};\n    const canvas=document.createElement('canvas');canvas.width=512;canvas.height=512;\n    const ctx=canvas.getContext('2d'),renderer=new PlatformRenderer({assets:game.assets});\n    const previous=window.DEBUG_COLLISIONS;window.DEBUG_COLLISIONS=false;\n    try {\n      ctx.save();ctx.translate(100-s.x,120-s.y);\n      renderer.renderPlatforms(ctx,{width:10000},0,{platforms:[p]});ctx.restore();\n      const pixels=ctx.getImageData(100,120,s.w,1).data;\n      for(let x=0;x<s.w;x++)if(pixels[x*4+3]!==255){\n        throw Error(`${index}: apoio visual transparente em x=${x}`);\n      }\n      // Verifica os fragmentos removidos do atlas em uma área de desenho transparente.\n      const scale=s.w/calibration.surfaceW;\n      const dw=Math.round(calibration.origW*scale),dh=Math.round(calibration.origH*scale);\n      const dx=Math.round(100-calibration.surfaceX*scale),dy=Math.round(120-calibration.surfaceY*scale);\n      for(const [x,y,w,h] of calibration.excludeRects||[]){\n        const px=Math.floor(dx+(x+w/2)*dw/calibration.origW);\n        const py=Math.floor(dy+(y+h/2)*dh/calibration.origH);\n        if(ctx.getImageData(px,py,1,1).data[3]!==0)throw Error(`${index}: fragmento do atlas ainda visível`);\n      }\n      return {checked:true,opaqueSupportPixels:s.w,excludedFragments:calibration.excludeRects?.length||0};\n    } finally {window.DEBUG_COLLISIONS=previous;}\n  },\n  detail(index){\n    const p=platforms[index],s=support(p),canvas=document.createElement('canvas');\n    canvas.width=960;canvas.height=400;\n    const ctx=canvas.getContext('2d'),renderer=new PlatformRenderer({assets:game.assets});\n    const character=new BabyRenderer(),previous=window.DEBUG_COLLISIONS;\n    window.DEBUG_COLLISIONS=false;\n    try {\n      for(const [i,[label,x]] of [['Esquerda',s.x],['Centro',s.x+(s.w-38)/2],['Direita',s.x+s.w-38]].entries()){\n        ctx.save();ctx.beginPath();ctx.rect(i*320,0,320,400);ctx.clip();\n        ctx.fillStyle='#211b2d';ctx.fillRect(i*320,0,320,400);\n        ctx.fillStyle='#fff';ctx.font='14px sans-serif';ctx.fillText(`${index}: ${p.style} — ${label}`,i*320+12,24);\n        ctx.translate(i*320+160-s.x-s.w/2,120-s.y);\n        renderer.renderPlatforms(ctx,{width:10000},0,{platforms:[p]});\n        const b={...createBabyState(),x,y:s.y-44,animTime:0,onGround:true};\n        character.render(ctx,b);\n        // Marca somente as extremidades, mantendo visível o contato real entre o sapato e o objeto.\n        ctx.strokeStyle='#4ade80';ctx.lineWidth=1;\n        for(const edge of [s.x,s.x+s.w]){\n          ctx.beginPath();ctx.moveTo(edge,s.y-6);ctx.lineTo(edge,s.y+8);ctx.stroke();\n        }\n        ctx.restore();\n      }\n      return canvas.toDataURL('image/png').split(',')[1];\n    } finally {window.DEBUG_COLLISIONS=previous;}\n  },\n  show(index,debug=false){const s=support(platforms[index]);game.review.prepare(index,s.x+(s.w-38)/2);\n    game.state.baby.vx=0;window.DEBUG_COLLISIONS=debug;game.review.draw();}\n};\ndocument.body.dataset.ready='true';\n// Ponto de entrada opcional para revisão sem interface gráfica: exercita o ciclo real de atualização e\n// mostra detalhes dos contatos sem adicionar controles de depuração ao jogo distribuído.\nif (new URLSearchParams(location.search).has('verify')) {\n  try {\n    for (const dt of [0.5, 1, 1.2]) {\n      for (let target=0; target<=21; target++) window.review.run(target,dt);\n      for (let target=0; target<=15; target++) window.review.run(target,dt,true);\n      game.review.prepare(9,1631);\n      for (let frame=0; frame<300; frame++) {\n        game.review.step(dt);\n        const b=game.state.baby;\n        if (!b.onGround || b.x!==1631 || b.y!==192 || b.vx!==0)\n          throw Error(`Falha na pausa do castelo em dt=${dt}, quadro=${frame}`);\n      }\n      game.review.jump();\n      for(let frame=0;frame<240 && !game.state.baby.onGround;frame++) game.review.step(dt);\n      if(game.state.baby.currentPlatformIndex!==10)throw Error('O salto do castelo não alcançou o trem');\n    }\n    const gallery=document.createElement('div');\n    for (const index of [10,11,12]) {\n      const img=new Image();img.src='data:image/png;base64,'+window.review.detail(index);\n      img.style.width='960px';img.style.display='block';gallery.append(img);\n    }\n    document.querySelector('canvas').remove();document.body.prepend(gallery);\n    document.querySelector('#feedback').textContent='APROVADO: atualizações reais, 114 saltos e 900 quadros de pausa no castelo';\n    document.body.dataset.result='passed';\n  } catch(error) {\n    document.body.dataset.result='failed';\n    document.querySelector('#feedback').textContent=error.stack;\n  }\n}\n</script></html>\n"
}
