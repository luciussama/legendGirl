{
  "schemaVersion": 1,
  "id": "eeca2eda786ad489e4156a7fe78c21cf7bfa599c936437ada1d22e3699fe56f1",
  "path": "tests/combat-correction-review.html",
  "sha256": "c5e1fb1dec9e221e67e7569d802766ef4d31bff551dbad76aad69f49811157e1",
  "capturedAt": "2026-10-13T19:09:12.143447+00:00",
  "origin": {
    "type": "qa-arquivado"
  },
  "encoding": "utf-8",
  "content": "<!doctype html>\n<html lang=\"pt-BR\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Revalidação das correções de combate</title>\n<style>body{margin:24px;background:#17121f;color:#f7e9cf;font:16px system-ui}h1{font-size:26px}button{padding:10px;margin-right:12px}main{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:18px}article{border:1px solid #655541;border-radius:12px;padding:12px;background:#241e2a}canvas{display:block;width:100%;height:240px;background:repeating-conic-gradient(#35303a 0% 25%,#29242e 0% 50%) 0/20px 20px}p{line-height:1.5}#status{position:sticky;top:0;background:#17121f;padding:12px}</style></head>\n<body><h1>Sprites do modo batalha — revisão visual</h1><p>Ferramenta de revisão isolada, sem integração ao gameplay. A taxa de 6 quadros/s serve apenas à inspeção, sem definir tempos de combate.</p>\n<div id=\"status\"><button id=\"pause\">Pausar animações</button><button id=\"step\">Avançar um quadro</button><span id=\"result\">Carregando…</span></div><label>Escala: <select id=\"scale\"><option value=\"1.25\">Ampliada</option><option value=\"0.35\">Pequena — hipótese de apresentação</option></select></label><p>A escala de batalha ainda não foi integrada. A revisão pequena é uma hipótese explícita, não uma medição do gameplay final.</p><main></main>\n<script type=\"module\">\nconst root='../assets/art/toy-room/battle/';\nlet paused=false,frame=0,last=0;\nconst views=[];\ntry{\n const manifest=await(await fetch(root+'corrections/manifest.json')).json();\n const names={train:'Trem',robot:'Robô',dinosaur:'Dinossauro',bear:'Urso'};\n for(const [actor,data] of Object.entries(manifest.actors))for(const [name,animation]of Object.entries(data.animations)){\n  const article=document.createElement('article'),title=document.createElement('h2'),canvas=document.createElement('canvas'),caption=document.createElement('p');\n  title.textContent=names[actor]+' — '+name;canvas.width=640;canvas.height=480;\n  const images=await Promise.all(animation.frames.map(f=>new Promise((resolve,reject)=>{const img=new Image();img.onload=()=>resolve(img);img.onerror=()=>reject(Error('Falha ao carregar '+f.file));img.src=root+f.file;})));\n  article.append(title,canvas,caption);document.querySelector('main').append(article);views.push({canvas,caption,images,animation});\n }\n\n for(const [actor,data] of Object.entries(manifest.actors)){\n  const attacks=Object.keys(data.animations).filter(n=>!['Idle','Walk','Hit','Death','Enrage'].includes(n));\n  for(const attack of attacks){\n   const order=['Idle','Walk',attack,'Hit','Walk','Death'];\n   if(attack==='Toy Leap')order.splice(5,0,'Toy Leap');\n   const animation={frames:order.flatMap(n=>data.animations[n].frames),loop:false};\n   const article=document.createElement('article'),title=document.createElement('h2'),canvas=document.createElement('canvas'),caption=document.createElement('p');\n   title.textContent=names[actor]+' — transições com '+attack;canvas.width=640;canvas.height=480;\n   const images=await Promise.all(animation.frames.map(f=>new Promise((resolve,reject)=>{const img=new Image();img.onload=()=>resolve(img);img.onerror=()=>reject(Error('Falha '+f.file));img.src=root+f.file;})));\n   article.append(title,canvas,caption);document.querySelector('main').append(article);views.push({canvas,caption,images,animation});\n  }\n }\n document.querySelector('#result').textContent='CARREGAMENTO CONCLUÍDO. Correções em revalidação, sem aprovação automática.';\n document.body.dataset.result='passed';\n function draw(){for(const v of views){const i=frame%v.images.length,f=v.animation.frames[i],ctx=v.canvas.getContext('2d');ctx.clearRect(0,0,640,480);const scale=f.displayScale*Number(document.querySelector('#scale').value);ctx.drawImage(v.images[i],320-f.anchor.x*scale,430-f.anchor.y*scale,f.width*scale,f.height*scale);v.caption.textContent=`Quadro ${i+1}/${v.images.length} • ${v.animation.loop?'ciclo':'ação reproduzida em ciclo apenas para revisão'}`;}}\n document.querySelector('#pause').onclick=()=>{paused=!paused;document.querySelector('#pause').textContent=paused?'Continuar animações':'Pausar animações';};\n document.querySelector('#step').onclick=()=>{paused=true;document.querySelector('#pause').textContent='Continuar animações';frame++;draw();};\n function tick(t){if(!paused&&t-last>=1000/6){last=t;frame++;draw();}requestAnimationFrame(tick);}draw();requestAnimationFrame(tick);\n}catch(error){document.querySelector('#result').textContent='FALHA: '+error.message;document.body.dataset.result='failed';}\n</script></body></html>\n"
}
