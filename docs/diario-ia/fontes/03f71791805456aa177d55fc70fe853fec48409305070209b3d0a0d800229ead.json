  "encoding": "utf-8",
  "content": "<!doctype html>\n<html lang=\"pt-BR\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Revisão dos sprites de batalha</title>\n<style>body{margin:24px;background:#17121f;color:#f7e9cf;font:16px system-ui}h1{font-size:26px}button{padding:10px;margin-right:12px}main{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:18px}article{border:1px solid #655541;border-radius:12px;padding:12px;background:#241e2a}canvas{display:block;width:100%;height:240px;background:repeating-conic-gradient(#35303a 0% 25%,#29242e 0% 50%) 0/20px 20px}p{line-height:1.5}#status{position:sticky;top:0;background:#17121f;padding:12px}</style></head>\n<body><h1>Sprites do modo batalha — revisão visual</h1><p>Ferramenta de revisão isolada, sem integração ao gameplay. A taxa de 6 quadros/s serve apenas à inspeção, sem definir tempos de combate.</p>\n<div id=\"status\"><button id=\"pause\">Pausar animações</button><button id=\"step\">Avançar um quadro</button><span id=\"result\">Carregando…</span></div><main></main>\n<script type=\"module\">\nconst root='../assets/art/toy-room/battle/';\nlet paused=false,frame=0,last=0;\nconst views=[];\ntry{\n const manifest=await(await fetch(root+'manifest.json')).json();\n const names={train:'Trem',robot:'Robô',dinosaur:'Dinossauro',bear:'Urso'};\n for(const [actor,data] of Object.entries(manifest.actors))for(const [name,animation]of Object.entries(data.animations)){\n  const article=document.createElement('article'),title=document.createElement('h2'),canvas=document.createElement('canvas'),caption=document.createElement('p');\n  title.textContent=names[actor]+' — '+name;canvas.width=640;canvas.height=480;\n  const images=await Promise.all(animation.frames.map(f=>new Promise((resolve,reject)=>{const img=new Image();img.onload=()=>resolve(img);img.onerror=()=>reject(Error('Falha ao carregar '+f.file));img.src=root+f.file;})));\n  article.append(title,canvas,caption);document.querySelector('main').append(article);views.push({canvas,caption,images,animation});\n }\n document.querySelector('#result').textContent='CARREGAMENTO CONCLUÍDO: 144 PNGs; 26 sequências. Homologação artística pendente.';\n document.body.dataset.result='passed';\n function draw(){for(const v of views){const i=frame%v.images.length,f=v.animation.frames[i],ctx=v.canvas.getContext('2d');ctx.clearRect(0,0,640,480);const scale=f.displayScale*1.25;ctx.drawImage(v.images[i],320-f.anchor.x*scale,430-f.anchor.y*scale,f.width*scale,f.height*scale);v.caption.textContent=`Quadro ${i+1}/${v.images.length} • ${v.animation.loop?'ciclo':'ação reproduzida em ciclo apenas para revisão'}`;}}\n document.querySelector('#pause').onclick=()=>{paused=!paused;document.querySelector('#pause').textContent=paused?'Continuar animações':'Pausar animações';};\n document.querySelector('#step').onclick=()=>{paused=true;document.querySelector('#pause').textContent='Continuar animações';frame++;draw();};\n function tick(t){if(!paused&&t-last>=1000/6){last=t;frame++;draw();}requestAnimationFrame(tick);}draw();requestAnimationFrame(tick);\n}catch(error){document.querySelector('#result').textContent='FALHA: '+error.message;document.body.dataset.result='failed';}\n</script></body></html>\n"
}
