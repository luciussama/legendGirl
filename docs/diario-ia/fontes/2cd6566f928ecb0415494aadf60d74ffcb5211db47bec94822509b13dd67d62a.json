  "encoding": "utf-8",
  "content": "<!doctype html>\n<html lang=\"pt-BR\">\n<meta charset=\"utf-8\">\n<base href=\"../\">\n<title>Inspeção das plataformas do quarto escuro</title>\n<style>body{margin:0;background:#131121;color:#eee;font:14px sans-serif}h1,p{margin:16px}canvas{display:block}</style>\n<h1>Quarto escuro — superfícies de apoio</h1>\n<p>Verde: área real de colisão. Branco: corpo de 38 × 44 px no centro do apoio. Imagens e renderizador de produção.</p>\n<canvas width=\"1360\" height=\"1740\"></canvas>\n<script type=\"module\">\nimport {platforms,createBabyState} from '../src/js/config.js';\nimport {PlatformRenderer} from '../src/js/environment/PlatformRenderer.js';\nimport {AssetManager} from '../src/js/assets/AssetManager.js';\nconst assets=new AssetManager();\nawait assets.loadManifest();\nawait Promise.all(Object.entries(assets.manifest.images).filter(([k])=>k.startsWith('dark-room')).map(([k,v])=>assets.loadImage(k,v)));\nconst renderer=new PlatformRenderer({assets});\nconst canvas=document.querySelector('canvas'),ctx=canvas.getContext('2d');\nwindow.DEBUG_COLLISIONS=true;\nfor(let i=0;i<platforms.length;i++){\n  const p=platforms[i],x=i%4*340,y=Math.floor(i/4)*290;\n  const sx=p.standRegion?.x??p.x,sw=p.standRegion?.w??p.w;\n  const sy=p.surfaceTopY??p.standRegion?.y??p.y;\n  ctx.save();ctx.beginPath();ctx.rect(x,y,340,290);ctx.clip();\n  ctx.fillStyle=i%2?'#211b2d':'#191725';ctx.fillRect(x,y,340,290);\n  ctx.fillStyle='#eee';ctx.font='14px sans-serif';ctx.fillText(`${i}: ${p.style}`,x+12,y+20);\n  ctx.translate(x+170-(sx+sw/2),y+135-sy);\n  renderer.renderPlatforms(ctx,{width:10000},0,{platforms:[p]});\n  const b=createBabyState();ctx.strokeStyle='#fff';ctx.lineWidth=1;\n  ctx.strokeRect(sx+(sw-b.w)/2,sy-b.h,b.w,b.h);\n  ctx.restore();\n}\ndocument.body.dataset.ready='true';\n</script>\n</html>\n"
}
