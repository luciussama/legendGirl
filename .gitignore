node_modules/
dist/
.env
.DS_Store
*.log



# Evidências locais de auditoria e capturas regeneráveis.
/docs/qa/
/docs/melhorias-atlas/
/docs/character-reference-atlas/
/assets/qa-testers/

# Cópias recuperáveis das exclusões aprovadas na revisão visual.
/.sprite-review-quarantine/

# Banco operacional local; exportar pendências antes de remover
/docs/diario-ia/*.sqlite3
/docs/diario-ia/*.sqlite3.tmp
/docs/diario-ia/*.sqlite3-wal
/docs/diario-ia/*.sqlite3-shm
/docs/diario-ia/.sqlite.lock
/docs/diario-ia/segmentos/*.tmp
/docs/diario-ia/**/*.tmp-*

# Cache local das automações Python
__pycache__/
*.pyc

# QA e relatórios de máquina vivem apenas no diário de IA.
/tests/
/scripts/test-*
/scripts/review-*
/scripts/verify-*
/scripts/capture-*
/scripts/audit-*
/scripts/analyze-*
/scripts/qa-*
/docs/battle-mode/*-report.*
/docs/battle-mode/*evidence*/

# Cópias de trabalho: conteúdo consolidado em fontes/pacotes do diário.
/docs/diario-ia/qa/
/docs/diario-ia/analises/
/docs/diario-ia/automacoes/
/docs/diario-ia/planos/
/docs/diario-ia/qa-resultados/
